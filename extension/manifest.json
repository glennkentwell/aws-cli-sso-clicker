{
  "manifest_version": 3,
  "version": "1.0",
  "name": "AWS SSO Auto Clicker",
  "description": "Automatically clicks through the approve steps of the AWS SSO login flow.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AWS SSO Auto Clicker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "js": ["login.js"],
      "matches": [
        "https://device.sso.ap-southeast-2.amazonaws.com/*",
        "https://dabble.awsapps.com/start/*"
      ]
    }
  ]
}
